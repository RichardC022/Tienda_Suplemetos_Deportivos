# ============================================================
# Configuracion de entorno del chatbot.
# Copia este archivo como ".env" y ajusta los valores.
# ============================================================

# --- Proveedor del LLM ---
# Valores posibles: openai | gemini | local
LLM_PROVIDER=local

# --- OpenAI (si LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

# --- Gemini (si LLM_PROVIDER=gemini) ---
# Requiere: pip install langchain-google-genai
GOOGLE_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash

# --- Modelo local via Ollama (si LLM_PROVIDER=local) ---
# Instala Ollama: https://ollama.com  y ejecuta: ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3

# --- Embeddings ---
# Modelo de sentence-transformers (local, sin API key)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Base de datos vectorial (ChromaDB local) ---
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=manual_usuario

# --- RAG: parametros de recuperacion ---
CHUNK_SIZE=800            # Tamanho de cada fragmento de texto (caracteres)
CHUNK_OVERLAP=100         # Solapamiento entre fragmentos
RETRIEVER_K=4             # Numero de fragmentos relevantes a recuperar
